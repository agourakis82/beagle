PROJECT_SLUG=my-project
PROJECT_NAMESPACE=beagle
PROJECT_MODE=always-on
PROJECT_WORKSTREAM_ID=my-project-main
PROJECT_REPO_URL=https://github.com/example/example.git
PROJECT_REPO_BRANCH=main
PROJECT_STORAGE_CLASS=ceph-rbd-ssd-rwop
PROJECT_STORAGE_SIZE=50Gi
WORKSPACE_ID=my-project-workspace
SESSION_ID=my-project-session
WORKSPACE_BROWSER_URL=http://my-project-workspace.beagle.svc.cluster.local:8080
PROJECT_BROWSER_AUTOMATION_COMMAND=agent-browser
PROJECT_BROWSER_AUTOMATION_URL=
PROJECT_BROWSER_AUTOMATION_PUBLIC_URL=
IDE_IMAGE=localhost/sounio-workspace-ide:0406231500
SSH_IMAGE=localhost/beagle-workspace-ssh:b216
PROJECT_VSIX_PACK=core-sovereign
PROJECT_VSIX_PACK_VERSION=sov-v1
PROJECT_VSIX_ENABLE_RECOMMENDED=true
PROJECT_VSIX_ENABLE_EXPERIMENTAL=false
PROJECT_VSIX_REQUIRED_EXTENSIONS=
PROJECT_VSIX_RECOMMENDED_EXTENSIONS=
PROJECT_VSIX_EXPERIMENTAL_EXTENSIONS=
WORKSPACE_CONFIGMAP_NAME=sounio-workspace-config
CORE_SECRETS_SECRET_NAME=beagle-core-secrets
SSH_AUTHORIZED_KEYS_SECRET_NAME=sounio-workspace-ssh-authorized-keys
PROJECT_REPO_SECRET_NAME=my-project-repo-auth
WORKSPACE_NODE_PREFERENCE=t560-proxmox
