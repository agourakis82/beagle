apiVersion: batch/v1
kind: Job
metadata:
  name: ${BUILD_JOB_NAME}
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/name: sounio-loom-canary-image-build
    app.kubernetes.io/instance: ${BUILD_JOB_NAME}
    app.kubernetes.io/managed-by: beagle-source-control
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: sounio-loom-canary-image-build
        app.kubernetes.io/instance: ${BUILD_JOB_NAME}
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      nodeSelector:
        kubernetes.io/hostname: ${NODE_NAME}
      initContainers:
        - name: source-proof
          image: alpine/git:latest
          command: ["/bin/sh", "-lc"]
          args:
            - |
              set -eu
              git clone --depth 1 --single-branch --branch "$BEAGLE_SOURCE_REF" \
                "$BEAGLE_REPO_URL" /workspace
              actual="$(git -C /workspace rev-parse HEAD)"
              if [ "$actual" != "$BEAGLE_SOURCE_COMMIT" ]; then
                git -C /workspace fetch --depth 1 origin "$BEAGLE_SOURCE_COMMIT"
                git -C /workspace checkout --detach "$BEAGLE_SOURCE_COMMIT"
              fi
              test "$(git -C /workspace rev-parse HEAD)" = "$BEAGLE_SOURCE_COMMIT"
          env:
            - name: BEAGLE_REPO_URL
              value: ${BEAGLE_REPO_URL}
            - name: BEAGLE_SOURCE_REF
              value: ${BEAGLE_SOURCE_REF}
            - name: BEAGLE_SOURCE_COMMIT
              value: ${BEAGLE_SOURCE_COMMIT}
          volumeMounts:
            - name: source
              mountPath: /workspace
      containers:
        - name: kaniko
          image: gcr.io/kaniko-project/executor:latest
          args:
            - --dockerfile=/workspace/k8s/workspace-platform/images/sounio-loom-canary/Dockerfile
            - --context=dir:///workspace
            - --destination=${IMAGE_DESTINATION}
            - --insecure-registry=192.168.3.207:5003
            - --cache=false
            - --snapshot-mode=redo
            - --verbosity=info
          volumeMounts:
            - name: source
              mountPath: /workspace
          resources:
            requests:
              cpu: "1"
              memory: 1Gi
            limits:
              cpu: "4"
              memory: 4Gi
      volumes:
        - name: source
          emptyDir:
            sizeLimit: 2Gi
