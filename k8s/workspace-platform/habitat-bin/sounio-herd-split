#!/usr/bin/env bash
# sounio-herd-split - ensure/revive lanes in the "fleet" session.
#
# The fleet uses one tmux session with one window per lane. Lanes listed in
# SOUNIO_HERD_EXCLUDE_LANES belong to an external recovery authority and are
# observed but never created, respawned, started, or killed by this script.
#
# Usage:
#   sounio-herd-split            create missing windows and revive dead lanes
#   sounio-herd-split --agents   also start idle legacy agents
#   sounio-herd-split --status   show legacy and externally managed lanes
#   sounio-herd-split --kill     refuse; fleet is the live shared session
set -euo pipefail

BASE_HOME=/workspace/.home/openvscode-server
REPO=/workspace/sounio
SESSION="${SOUNIO_FLEET_SESSION:-fleet}"
LANE_SHELL="$BASE_HOME/bin/sounio-lane-shell"
LANES="repo claude-1 claude-2 claude-3 fable-1 codex-1 codex-2 codex-3 kimi-cli1 kimi-cli2 grok-cli1 grok-cli2 grok-cli3 grok-cli4 grok-cli5 cursor-1 cursor-2 cursor-3 glm-cli1 glm-cli2 minimax-cli1 minimax-cli2 minimax-cli3 empryo-1 qwen"
EXCLUDED_LANES="${SOUNIO_HERD_EXCLUDE_LANES:-}"

export TMUX_TMPDIR="${TMUX_TMPDIR:-$BASE_HOME/.tmux}"
mkdir -p "$TMUX_TMPDIR"

tmux start-server 2>/dev/null || true
tmux set-option -wg remain-on-exit on >/dev/null 2>&1 || true

cmd_for() {
  case "$1" in
    claude-*|fable-1) echo claude ;;
    codex-*)          echo codex ;;
    kimi-cli*)        echo kimi ;;
    grok-cli*)        echo grok ;;
    cursor-*)         echo cursor ;;
    glm-cli*)         echo glm ;;
    minimax-cli*)     echo minimax ;;
    empryo-1|qwen)    echo empryo ;;
    *)                echo "" ;;
  esac
}

has_fleet() { tmux has-session -t "=$SESSION" 2>/dev/null; }

has_window() {
  has_fleet || return 1
  tmux list-windows -t "=$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx -- "$1"
}

lane_excluded() {
  case " $EXCLUDED_LANES " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

lane_dead() {
  [ "$(tmux display-message -p -t "=$SESSION:$1" '#{pane_dead}' 2>/dev/null || echo 0)" = "1" ]
}

lane_busy() {
  local cur
  cur="$(tmux display-message -p -t "=$SESSION:$1" '#{pane_current_command}' 2>/dev/null || echo '')"
  case "$cur" in
    ''|bash|zsh|sh|-bash|-zsh) return 1 ;;
    *) return 0 ;;
  esac
}

supervisor_status() {
  local common helper output rc=0
  common="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  helper="$common/sounio-coord-runtime/current/bin/sounio-fleet-agent-runtime"
  echo
  echo "  supervisor duravel (agentd):"
  if [[ -z "$common" || ! -x "$helper" ]]; then
    echo "  indisponivel: runtime compartilhado sem fleet-launcher-v1"
    return 0
  fi
  output="$("$helper" status --cwd "$REPO" 2>&1)" || rc=$?
  if [[ "$output" == 'fleet_slots=0 unhealthy=0' ]]; then
    echo "  nenhum slot supervisionado ainda"
  else
    printf '%s\n' "$output" | sed 's/^/  /'
  fi
  [[ "$rc" == 0 ]] || echo "  atencao: ha slot supervisor indisponivel ou adulterado"
}

ensure_windows() {
  if ! has_fleet; then
    echo "  sessao '$SESSION' nao existe - criando com a primeira lane" >&2
    local first="${LANES%% *}"
    tmux new-session -d -s "$SESSION" -n "$first" -c "$REPO" "$LANE_SHELL $first" \
      && echo "  janela criada: $first" || {
        echo "  FALHOU ao criar a sessao: $SESSION" >&2
        exit 1
      }
  fi
  local lane
  for lane in $LANES; do
    if lane_excluded "$lane"; then
      echo "  lane sob autoridade externa: $lane"
      continue
    fi
    if has_window "$lane"; then
      if lane_dead "$lane"; then
        tmux respawn-pane -k -t "=$SESSION:$lane" "$LANE_SHELL $lane" 2>/dev/null \
          && echo "  lane revivida: $lane" || echo "  FALHOU ao reviver: $lane" >&2
      fi
      continue
    fi
    if tmux new-window -d -t "=$SESSION" -n "$lane" -c "$REPO" "$LANE_SHELL $lane" 2>/dev/null; then
      echo "  janela criada: $lane"
    else
      echo "  FALHOU ao criar janela: $lane" >&2
    fi
  done
}

start_agents() {
  local lane cmd
  for lane in $LANES; do
    lane_excluded "$lane" && continue
    cmd="$(cmd_for "$lane")"
    [ -z "$cmd" ] && continue
    if ! has_window "$lane"; then
      echo "  sem janela para $lane" >&2
      continue
    fi
    if lane_dead "$lane"; then
      tmux respawn-pane -k -t "=$SESSION:$lane" "$LANE_SHELL $lane" 2>/dev/null \
        && echo "  lane revivida: $lane" || echo "  FALHOU ao reviver: $lane" >&2
      continue
    fi
    if lane_busy "$lane"; then
      echo "  ja rodando: $lane"
      continue
    fi
    tmux send-keys -t "=$SESSION:$lane" "exec $LANE_SHELL $lane" C-m
    echo "  agente enviado: $lane ($cmd)"
  done
}

status() {
  local lane cur
  if ! has_fleet; then
    echo "  sessao '$SESSION' nao existe"
    return
  fi
  printf '  %-12s %-14s %s\n' JANELA PROCESSO ESTADO
  for lane in $LANES; do
    if lane_excluded "$lane"; then
      printf '  %-12s %-14s %s\n' "$lane" '-' 'autoridade externa'
      continue
    fi
    if ! has_window "$lane"; then
      printf '  %-12s %-14s %s\n' "$lane" '-' 'ausente'
      continue
    fi
    cur="$(tmux display-message -p -t "=$SESSION:$lane" '#{pane_current_command}' 2>/dev/null || echo '?')"
    if lane_dead "$lane"; then
      printf '  %-12s %-14s %s\n' "$lane" '(morto)' '<- revive com --agents'
    else
      printf '  %-12s %-14s %s\n' "$lane" "$cur" ''
    fi
  done
  echo
  echo "  cada linha e uma JANELA da sessao '$SESSION'."
  supervisor_status
}

case "${1:-}" in
  --kill)
    echo "  recusado: a sessao '$SESSION' e a frota viva"
    echo "  para derrubar uma janela especifica: tmux kill-window -t $SESSION:<lane>"
    exit 1
    ;;
  --status) status; exit 0 ;;
esac

ensure_windows
if [ "${1:-}" = "--agents" ]; then
  start_agents
fi
echo
status
echo
echo "Pronto. 'sounio' (ou 'sounio <lane>') anexa na fleet."
