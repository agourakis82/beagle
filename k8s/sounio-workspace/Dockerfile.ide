FROM docker.io/gitpod/openvscode-server@sha256:236821ee7c8f9284b7f94799d4b66bc465926f435ac323af03e50bfb503c1ca1 AS openvscode

FROM ghcr.io/slinkyproject/login:25.11-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    OPENVSCODE_SERVER_ROOT=/home/.openvscode-server

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      build-essential \
      ca-certificates \
      clang \
      cmake \
      curl \
      docker.io \
      file \
      fonts-liberation \
      gh \
      git \
      jq \
      libasound2t64 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libatspi2.0-0 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libglib2.0-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libx11-6 \
      libx11-xcb1 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      libxshmfence1 \
      lld \
      llvm \
      make \
      netcat-openbsd \
      ninja-build \
      openssh-client \
      pkg-config \
      python3 \
      python3-pip \
      ripgrep \
      sudo \
      tmux \
      zsh \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /usr/bin/zsh openvscode-server \
    && mkdir -p /workspace /home/openvscode-server/.ssh "${OPENVSCODE_SERVER_ROOT}" \
    && chown -R openvscode-server:openvscode-server /workspace /home/openvscode-server "${OPENVSCODE_SERVER_ROOT}" \
    && mkdir -p /etc/sudoers.d \
    && printf 'openvscode-server ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/openvscode-server \
    && chmod 0440 /etc/sudoers.d/openvscode-server

COPY --from=openvscode --chown=openvscode-server:openvscode-server /home/.openvscode-server /home/.openvscode-server

USER openvscode-server
