diff --git a/internal/defaults/controller.go b/internal/defaults/controller.go
index 92e427b..7f94faf 100644
--- a/internal/defaults/controller.go
+++ b/internal/defaults/controller.go
@@ -11,7 +11,9 @@ import (
 
 // Default values for Controller Spec fields when unspecified.
 const (
-	DefaultControllerPersistenceEnabled bool = true
+	DefaultControllerPersistenceEnabled bool   = true
+	DefaultControllerReconfigureImage  string = "ghcr.io/slinkyproject/slurmctld:25.11-ubuntu24.04"
+	DefaultControllerLogFileImage      string = "ghcr.io/slinkyproject/slurmctld:25.11-ubuntu24.04"
 )
 
 // SetControllerDefaults applies default values for Controller spec fields.
@@ -31,4 +33,12 @@ func SetControllerDefaults(controller *slinkyv1beta1.Controller) {
 	if s.Persistence.Enabled == nil {
 		s.Persistence.Enabled = ptr.To(DefaultControllerPersistenceEnabled)
 	}
+
+	if s.Reconfigure.Image == "" {
+		s.Reconfigure.Image = DefaultControllerReconfigureImage
+	}
+
+	if s.LogFile.Image == "" {
+		s.LogFile.Image = DefaultControllerLogFileImage
+	}
 }
