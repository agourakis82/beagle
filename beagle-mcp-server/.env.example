# BEAGLE MCP Server Configuration
# Copy this file to .env and adjust values as needed

# ========================================
# BEAGLE Core API Configuration
# ========================================

# Base URL for BEAGLE core HTTP server
# Default: http://localhost:8080
# When using Cloudflare Tunnel externally, keep this as localhost
# (MCP talks to local BEAGLE, Cloudflare proxies external requests)
BEAGLE_CORE_URL=http://localhost:8080

# API authentication token for BEAGLE core
# REQUIRED when BEAGLE_PROFILE=prod
# Optional in dev/lab profiles (but recommended)
# This token must match BEAGLE_API_TOKEN on the BEAGLE core side
# Example: BEAGLE_CORE_API_TOKEN=your-secret-token-here
BEAGLE_CORE_API_TOKEN=

# Optional cockpit boundary for agent-session tools. If omitted, those tools
# fall back to BEAGLE_CORE_URL.
BEAGLE_COCKPIT_URL=https://beagle.chiuratto.ai

# ========================================
# MCP Transport Configuration
# ========================================

# Client type detection (optional)
# Options: "claude" | "chatgpt" | auto-detect
# MCP_CLIENT_TYPE=claude

# Transport protocol (optional)
# Options: "stdio" | "http"
# Default: "stdio" for Claude Desktop, can be "http" for ChatGPT Apps
# MCP_TRANSPORT=stdio

# Enable Claude Desktop integration (default: true)
# CLAUDE_DESKTOP_ENABLED=true

# Enable OpenAI Apps SDK integration (default: false)
# Set to true when using ChatGPT Apps SDK
# OPENAI_APPS_SDK_ENABLED=false

# HTTP server port (only for HTTP transport)
# Default: 3000
# MCP_HTTP_PORT=3000

# Public HTTPS origin for hosted MCP clients.
# Use the external connector origin, not the tailnet/private service URL.
# MCP_PUBLIC_BASE_URL=https://mcp.agourakis.com

# Public tool surface.
# - trusted_full: full authenticated non-destructive Beagle nervous system
# - review_safe: search/fetch/Home/read-only memory and status tools for cautious review
# MCP_TOOL_SURFACE=trusted_full

# Allow unauthenticated initialize/list discovery for hosted connector setup.
# Tool calls and protected reads still require auth/scopes.
# MCP_PUBLIC_DISCOVERY=true

# ========================================
# HTTP Client Configuration
# ========================================

# Request timeout in milliseconds
# Default: 60000 (60 seconds)
# HTTP_TIMEOUT=60000

# Maximum number of retries for failed requests
# Default: 2
# HTTP_MAX_RETRIES=2

# ========================================
# Security & Rate Limiting
# ========================================

# Enable authentication (optional). MCP_REQUIRE_AUTH is kept as the public
# spelling; MCP_ENABLE_AUTH is also supported for older launchers.
# If set, HTTP clients must provide Authorization: Bearer <MCP_AUTH_TOKEN>.
# MCP_REQUIRE_AUTH=false
# MCP_ENABLE_AUTH=false
# If MCP_AUTH_TOKEN is omitted, BEAGLE_CORE_API_TOKEN is accepted as the MCP bearer.
# MCP_AUTH_TOKEN=

# Optional scoped-token map. Keys are bearer token values; values can be an
# array of scopes or an object with client_id/scopes. Leave unset for one broad
# trusted token with default scopes.
# MCP_TOKEN_SCOPE_MAP={"agent-token":{"client_id":"claude-desktop","scopes":["exocortex:read","memory:write"]}}
# MCP_DEFAULT_SCOPES=exocortex:read,memory:write,chronoself:write,research:run,agent:start

# Optional OAuth 2.1 protected-resource mode for hosted Claude/ChatGPT clients.
# Beagle MCP is the resource server; Auth0/Stytch/etc. is the authorization server.
# Do not set these until the issuer, JWKS, audience, and scopes are configured.
# MCP_AUTHORIZATION_SERVER_URL=https://auth.agourakis.com
# MCP_OAUTH_ISSUER=https://auth.agourakis.com
# Use the exact issuer string from the provider metadata, including trailing slash if present.
# MCP_OAUTH_JWKS_URI=https://auth.agourakis.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=https://mcp.agourakis.com/mcp
# MCP_RESOURCE_IDENTIFIER=https://mcp.agourakis.com/mcp
# MCP_RESOURCE_DOCUMENTATION_URL=https://mcp.agourakis.com/connector
# MCP_RESOURCE_METADATA_URL=https://mcp.agourakis.com/.well-known/oauth-protected-resource
# MCP_ALLOW_LEGACY_BEARER=false

# Optional public connector docs directory. In Docker this defaults to
# /app/docs/public/beagle_connector; in the repo it resolves ../docs/public/beagle_connector.
# MCP_CONNECTOR_DOCS_DIR=

# Rate limit: max requests per minute per client
# Default: 60
# RATE_LIMIT_PER_MINUTE=60

# ========================================
# Logging
# ========================================

# Log level: "debug" | "info" | "warn" | "error"
# Default: "info"
# LOG_LEVEL=info

# Log to file (optional)
# LOG_FILE=./logs/mcp-server.log

# ========================================
# Development / Debugging
# ========================================

# Enable verbose logging for debugging
# DEBUG=false

# Pretty-print JSON responses (useful for debugging)
# PRETTY_JSON=false
