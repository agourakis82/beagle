# BEAGLE MCP Server Configuration
# Copy this file to .env and adjust values as needed

# ========================================
# BEAGLE Core API Configuration
# ========================================

# Base URL for BEAGLE core HTTP server
# Default: http://localhost:8080
# When using Cloudflare Tunnel externally, keep this as localhost
# (MCP talks to local BEAGLE, Cloudflare proxies external requests)
BEAGLE_CORE_URL=http://localhost:8080

# API authentication token for BEAGLE core
# REQUIRED when BEAGLE_PROFILE=prod
# Optional in dev/lab profiles (but recommended)
# This token must match BEAGLE_API_TOKEN on the BEAGLE core side
# Example: BEAGLE_CORE_API_TOKEN=your-secret-token-here
BEAGLE_CORE_API_TOKEN=

# ========================================
# MCP Transport Configuration
# ========================================

# Client type detection (optional)
# Options: "claude" | "chatgpt" | auto-detect
# MCP_CLIENT_TYPE=claude

# Transport protocol (optional)
# Options: "stdio" | "http"
# Default: "stdio" for Claude Desktop, can be "http" for ChatGPT Apps
# MCP_TRANSPORT=stdio

# Enable Claude Desktop integration (default: true)
# CLAUDE_DESKTOP_ENABLED=true

# Enable OpenAI Apps SDK integration (default: false)
# Set to true when using ChatGPT Apps SDK
# OPENAI_APPS_SDK_ENABLED=false

# HTTP server port (only for HTTP transport)
# Default: 3000
# MCP_HTTP_PORT=3000

# ========================================
# HTTP Client Configuration
# ========================================

# Request timeout in milliseconds
# Default: 60000 (60 seconds)
# HTTP_TIMEOUT=60000

# Maximum number of retries for failed requests
# Default: 2
# HTTP_MAX_RETRIES=2

# ========================================
# Security & Rate Limiting
# ========================================

# Enable authentication (optional)
# If set, clients must provide Authorization header
# MCP_REQUIRE_AUTH=false

# Rate limit: max requests per minute per client
# Default: 60
# RATE_LIMIT_PER_MINUTE=60

# ========================================
# OAuth 2.0 Multi-Tenant Authentication
# ========================================

# Enable OAuth 2.0 authentication (opt-in, does not break existing bearer token auth)
# When enabled, both OAuth JWT tokens and static bearer tokens are accepted
# Default: false
# OAUTH_ENABLED=false

# JWT signing secret for OAuth tokens (REQUIRED if OAUTH_ENABLED=true)
# Can reuse MCP_AUTH_TOKEN or set a separate secret
# Minimum 32 characters recommended for security
# OAUTH_JWT_SECRET=your-256-bit-secret-here-change-in-production

# OAuth token issuer identifier (appears in JWT 'iss' claim)
# Default: beagle-mcp-server
# OAUTH_ISSUER=beagle-mcp-server

# Access token expiration time in milliseconds
# Default: 3600000 (1 hour)
# OAUTH_ACCESS_TOKEN_EXPIRY_MS=3600000

# Refresh token expiration time in milliseconds
# Default: 604800000 (7 days)
# OAUTH_REFRESH_TOKEN_EXPIRY_MS=604800000

# ========================================
# Logging
# ========================================

# Log level: "debug" | "info" | "warn" | "error"
# Default: "info"
# LOG_LEVEL=info

# Log to file (optional)
# LOG_FILE=./logs/mcp-server.log

# ========================================
# Development / Debugging
# ========================================

# Enable verbose logging for debugging
# DEBUG=false

# Pretty-print JSON responses (useful for debugging)
# PRETTY_JSON=false

# ========================================
# Webhook Configuration
# ========================================

# Path to webhook storage file (JSON)
# Default: ./data/webhooks.json
# WEBHOOK_STORE_PATH=./data/webhooks.json

# Path to webhook delivery log file (JSON)
# Default: ./data/webhook-deliveries.json
# WEBHOOK_DELIVERY_LOG_PATH=./data/webhook-deliveries.json

# ========================================
# Third-Party Integrations
# ========================================

# Tavily API Key for web search
# Get your free API key at: https://tavily.com
# Free tier: 1,000 API calls/month
TAVILY_API_KEY=
