#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CAPTURE="${ROOT_DIR}/scripts/beagle-work-memory-capture"
DAEMON="${ROOT_DIR}/scripts/beagle-work-memory-daemon"
GENERATE_ID="${ROOT_DIR}/scripts/beagle-generate-id"
TMP_DIR="$(mktemp -d)"
BLACKHOLE_PID=""

cleanup() {
  if [[ -n "${BLACKHOLE_PID}" ]] && kill -0 "${BLACKHOLE_PID}" 2>/dev/null; then
    kill "${BLACKHOLE_PID}" 2>/dev/null || true
    wait "${BLACKHOLE_PID}" 2>/dev/null || true
  fi
  rm -rf "${TMP_DIR}"
}
trap cleanup EXIT

fail() {
  echo "beagle-work-memory-resilience-selftest: FAIL $*" >&2
  exit 1
}

for command_name in bash curl node python3; do
  command -v "${command_name}" >/dev/null 2>&1 \
    || fail "missing command ${command_name}"
done

mkdir -p "${TMP_DIR}/fallback-path"
ln -s "$(command -v bash)" "${TMP_DIR}/fallback-path/bash"
ln -s "$(command -v tr)" "${TMP_DIR}/fallback-path/tr"
generated_id="$(PATH="${TMP_DIR}/fallback-path" "${GENERATE_ID}")"
[[ "${generated_id}" =~ ^[a-z0-9]+(-[a-z0-9]+)+$ ]] \
  || fail "generated id has unexpected format: ${generated_id}"

BEAGLE_MCP_LOCAL_ENV=/dev/null \
  "${CAPTURE}" \
    --agent codex \
    --phase test \
    --project beagle \
    --summary "generated id selftest" \
    --tool-manifest-hash selftest \
    --dry-run >"${TMP_DIR}/capture.json"

python3 - "${TMP_DIR}/capture.json" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    payload = json.load(handle)

session_id = payload.get("session_id", "")
if not re.fullmatch(r"codex-[0-9]{8}T[0-9]{6}Z-[a-z0-9]+(?:-[a-z0-9]+)+", session_id):
    raise SystemExit(f"unexpected generated session id: {session_id}")
PY

BEAGLE_WORK_MEMORY_DAEMON_DIR="${TMP_DIR}/daemon" \
BEAGLE_MCP_LOCAL_ENV=/dev/null \
  "${DAEMON}" \
    --agent codex \
    --project beagle \
    --repo-root "${ROOT_DIR}" \
    --once \
    --dry-run >"${TMP_DIR}/daemon.json"

python3 - "${TMP_DIR}/daemon/status.json" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    status = json.load(handle)

if status.get("status") != "dry-run":
    raise SystemExit(f"unexpected daemon status: {status.get('status')}")
session_id = status.get("session_id", "")
if not re.fullmatch(r"codex-daemon-[0-9]{8}T[0-9]{6}Z-[a-z0-9]+(?:-[a-z0-9]+)+", session_id):
    raise SystemExit(f"unexpected daemon session id: {session_id}")
PY

set +e
BEAGLE_MCP_LOCAL_ENV=/dev/null \
BEAGLE_WORK_MEMORY_CONNECT_TIMEOUT_SECONDS=0 \
  "${CAPTURE}" \
    --agent codex \
    --phase test \
    --project beagle \
    --summary "invalid timeout selftest" \
    --tool-manifest-hash selftest \
    --dry-run >"${TMP_DIR}/invalid.out" 2>"${TMP_DIR}/invalid.err"
invalid_rc=$?
set -e
[[ "${invalid_rc}" -eq 2 ]] || fail "invalid timeout returned ${invalid_rc}, expected 2"

port_file="${TMP_DIR}/blackhole.port"
node -e '
const fs = require("node:fs");
const http = require("node:http");
const path = process.argv[1];
const server = http.createServer(() => {});
server.listen(0, "127.0.0.1", () => fs.writeFileSync(path, String(server.address().port)));
' "${port_file}" &
BLACKHOLE_PID=$!

for _ in $(seq 1 100); do
  [[ -s "${port_file}" ]] && break
  sleep 0.02
done
[[ -s "${port_file}" ]] || fail "blackhole server did not publish a port"
blackhole_port="$(cat "${port_file}")"

started_at="$(date +%s)"
set +e
BEAGLE_MCP_LOCAL_ENV=/dev/null \
BEAGLE_CORE_URL="http://127.0.0.1:${blackhole_port}" \
BEAGLE_CORE_API_TOKEN=selftest \
BEAGLE_WORK_MEMORY_CONNECT_TIMEOUT_SECONDS=1 \
BEAGLE_WORK_MEMORY_REQUEST_TIMEOUT_SECONDS=1 \
  "${CAPTURE}" \
    --agent codex \
    --phase test \
    --project beagle \
    --summary "timeout sabotage" \
    --tool-manifest-hash selftest >"${TMP_DIR}/timeout.out" 2>"${TMP_DIR}/timeout.err"
timeout_rc=$?
set -e
elapsed="$(( $(date +%s) - started_at ))"

[[ "${timeout_rc}" -eq 6 ]] || fail "blackhole returned ${timeout_rc}, expected 6"
[[ "${elapsed}" -le 3 ]] || fail "blackhole refusal took ${elapsed}s, expected at most 3s"
grep -q "could not reach Beagle Core within 1s" "${TMP_DIR}/timeout.err" \
  || fail "bounded failure diagnostic missing"

echo "beagle-work-memory-resilience-selftest: PASS id=fallback daemon=dry-run invalid-timeout=refused blackhole=bounded-${elapsed}s"
