[Unit]
Description=BEAGLE MCP Server (Streamable HTTP / stdio)
After=network.target beagle-core.service
Requires=beagle-core.service

[Service]
Type=simple
User=demetrios
Group=demetrios
EnvironmentFile=-/etc/beagle-mcp.env
WorkingDirectory=%h/beagle/beagle-mcp-server
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
