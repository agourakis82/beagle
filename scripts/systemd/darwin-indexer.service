[Unit]
Description=DARWIN Incremental RAG Indexer
After=network.target

[Service]
Type=oneshot
User=demetrios
Group=demetrios
WorkingDirectory=/home/demetrios/beagle
EnvironmentFile=-/etc/darwin-indexer.env
ExecStart=/usr/bin/env bash -lc '/usr/local/bin/darwin-incremental-indexer --sync ${DARWIN_INDEX_ARGS}'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
