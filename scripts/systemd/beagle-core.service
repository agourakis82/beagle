[Unit]
Description=BEAGLE Core Server (HTTP API + Darwin Jobs)
After=network.target

[Service]
Type=simple
User=demetrios
Group=demetrios
EnvironmentFile=-/etc/beagle-core.env
WorkingDirectory=%h/beagle
ExecStart=/usr/local/bin/core_server
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
