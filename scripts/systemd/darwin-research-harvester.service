[Unit]
Description=DARWIN Research Harvester (multi-backend → darwin-papers)
After=network.target

[Service]
Type=oneshot
User=demetrios
Group=demetrios
EnvironmentFile=-/etc/darwin-harvester.env
ExecStart=/usr/bin/env bash -lc 'cd "${BEAGLE_WORKSPACE_ROOT:-%h/beagle}" && bash scripts/systemd/darwin-run.sh darwin-research-harvester ${DARWIN_HARVEST_ARGS}'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
