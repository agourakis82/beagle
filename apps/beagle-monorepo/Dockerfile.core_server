# syntax=docker/dockerfile:1
# Single-stage builder for core_server.
#
# NOTE: the in-cluster kaniko build-job runs with `--cache=false` (no layer cache), so cargo-chef's
# dependency-caching optimization brings ZERO benefit here — and it actively broke this image: the
# cargo-chef `cook` step builds `fn main(){}` stubs to cache deps, and the stub `core_server` (a 324KB
# binary that exits 0 immediately) leaked into target/release/ instead of the real server. We do a
# plain `cargo build` so the real source always compiles. Cargo.lock IS committed and copied so the
# image builds against the same pinned graph as CI. bookworm ships Python 3.11, so pyo3 builds fine.
# protobuf-compiler (protoc) is required: pulsar's build.rs (prost-build) needs it.

FROM rust:1.95-bookworm AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev python3-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY beagle-bin ./beagle-bin
COPY docs ./docs
RUN cargo build --release -p beagle-monorepo --bin core_server --features memory

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 10001 --create-home --home-dir /home/beagle beagle

WORKDIR /srv/beagle

ENV BEAGLE_BIND_ADDR=0.0.0.0:8080 \
    BEAGLE_DATA_DIR=/var/lib/beagle \
    BEAGLE_PROFILE=cluster

COPY --from=builder /workspace/target/release/core_server /usr/local/bin/core_server

RUN mkdir -p /var/lib/beagle \
    && chown -R beagle:beagle /var/lib/beagle /home/beagle

USER beagle

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/core_server"]
