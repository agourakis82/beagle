{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolBridgeResponse",
  "type": "object",
  "required": [
    "request_id",
    "status",
    "latency_ms",
    "output",
    "warnings"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "deferred"
      ]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "token_usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "output": {},
    "error": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
