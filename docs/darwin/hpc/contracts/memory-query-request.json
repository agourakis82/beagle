{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beagle Memory Query Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5
    },
    "domain": {
      "type": ["string", "null"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "include_recent_physio": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["query"]
}
